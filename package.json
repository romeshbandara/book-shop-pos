{
  "name": "book-shop-pos",
  "version": "1.0.3",
  "description": "",
  "main": "main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "electron .",
    "build:exe": "electron-builder --win",
    "release": "npm run build:frontend && electron-builder --publish always"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "axios": "^1.20.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "electron-updater": "^6.8.9",
    "express": "^5.3.0",
    "mongoose": "^9.11.2",
    "react-hot-toast": "^2.6.1",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3"
  },
  "build": {
    "appId": "com.pos.desktop",
    "productName": "BookShop POS",
    "directories": {
      "output": "dist-exe"
    },
    "files": [
      "main.js",
      "favicon.ico",
      "backend/**/*",
      "frontend/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "favicon.ico"
    },
    "nsis": {
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BookShop POS",
      "installerIcon": "favicon.ico",
      "uninstallerIcon": "favicon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "romeshbandara",
        "repo": "book-shop-pos"
      }
    ]
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3"
  }
}